Options -Indexes

<IfModule mod_authz_core.c>
  <FilesMatch "^\\.">
    Require all denied
  </FilesMatch>
  <FilesMatch "(?i)(^|/)(composer\\.(json|lock)|phpunit\\.xml(\\.dist)?|README(\\.md)?|CHANGELOG(\\.md)?|LICENSE|.*\\.(sql|log|ini|ya?ml|env|bak|old|orig|swp|dist|example))$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Application pages set their own Content-Security-Policy headers.
